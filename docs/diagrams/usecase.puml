@startuml usecase
left to right direction
skinparam actorStyle stick
skinparam packageStyle rectangle
skinparam shadowing false
actor "Developer" as Dev
actor "Frontend" <<system>> as Frontend
actor "Resume Parser Service" <<system>> as Parser

rectangle "PDF Generator Service" {
    usecase "Generate PDF" as UC_Generate
    usecase "Check Health" as UC_Health
    usecase "Browse API Docs" as UC_Docs
    usecase "Render PDF\nlocally (CLI)" as UC_CLI
}

Dev -> UC_Docs
Dev -> UC_CLI
Dev --> UC_Generate
Dev --> UC_Health

Frontend --> UC_Generate
Frontend --> UC_Health

Parser --> UC_Generate
@enduml
