@startuml activity_generate
skinparam shadowing false
start

:Receive JSON request with resume data;

:Parse and validate resume data;

if (Validation passed?) then (no)
    :Prepare validation error response;
else (yes)
    :Render resume data to Typst markup;

    :Compile Typst markup to a document;

    if (Compilation succeeded?) then (no)
        :Collect compilation diagnostics;
        :Prepare error response with diagnostics;
    else (yes)
        :Export document to PDF;

        if (Export succeeded?) then (no)
            :Prepare internal error response;
        else (yes)
            :Prepare PDF response;
        endif
    endif
endif

:Send response to client;

stop
@enduml
