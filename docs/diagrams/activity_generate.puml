@startuml activity_generate
skinparam shadowing false
start

:Receive **POST /generate** (JSON request body);

:Deserialize JSON -> **ResumeData** struct (axum + serde_json);

if (Schema validation OK?) then (fail)
    :Return **422** Unprocessable Entity;
    stop
endif

:Spawn blocking task (Tokio thread pool);

partition "Compiler::compile(data)" {
    :typst_writer::render(data) -> Typst source string;

    /' note right
      Serializes all resume sections
      into "#resume((...))".
      Text fields pass through
      str_to_content().
    end note '/

    :Build TypstEngine (fonts + source file resolver);

    :engine.compile("main.typ") -> Warned<Result<PagedDocument>>;

    if (Compile succeeded?) then (warnings)
        :Log Typst warnings (tracing::warn!);
    endif

    if (Compile succeeded?) then (no)
        :Extract diagnostics list;
        :Return **400** Bad Request + diagnostics JSON;
        stop
    endif

    :typst_pdf::pdf(document) -> Vec<u8> (PDF bytes);

    if (PDF export OK?) then (no)
        :Return **500** Internal Server Error;
        stop
    endif
}

:Return **200 OK** Content-Type: application/pdf (binary PDF body);

stop
@enduml
