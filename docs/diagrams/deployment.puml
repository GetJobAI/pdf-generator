@startuml deployment
skinparam shadowing false
skinparam nodeStyle rectangle
left to right direction

actor "HTTP Client" as HttpClient

node "Docker Engine" {
    node "proxy_network (bridge)" {
        artifact "gateway\nCaddy :80/:443" as Gateway

        node "pdf-generator container" {
            artifact "pdf-generator binary\n(fonts embedded)" as Binary
        }
    }
}

HttpClient --> Gateway : HTTPS :443
Gateway --> Binary : POST /generate
Binary --> Gateway : PDF bytes
@enduml
