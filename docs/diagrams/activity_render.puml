@startuml activity_render
skinparam shadowing false
start

:Receive structured resume data;

:Map each resume section to Typst named parameters;

while (More text fields to render?) is (yes)
    if (Field supports inline markup?) then (yes)
        while (More text remaining in field?) is (yes)
            if (Markup span found with matching close?) then (yes)
                :Emit equivalent\nTypst\nfunction call;
            else (no)
                :Escape special characters;
                :Emit plain text;
            endif
        endwhile (no)
    else (no)
        :Escape special characters;
        :Emit plain text;
    endif
endwhile (no)

:Combine rendered parameter string with Typst template;

:Output Typst source string;

stop
@enduml
